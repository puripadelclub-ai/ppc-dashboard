# Salin file ini menjadi .env untuk development lokal
# Di Vercel, isi nilai-nilai ini di Settings > Environment Variables

# Isi dengan seluruh konten file JSON service account Google Cloud
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"..."}

# ID folder Google Drive tempat upload Sales & Membership (manual)
# Ambil dari URL: https://drive.google.com/drive/folders/[INI_FOLDER_ID]
DRIVE_FOLDER_ID=your_drive_folder_id_here


# ID Google Sheet untuk OUTPUT (yang dibaca Looker Studio)
# Ambil dari URL: https://docs.google.com/spreadsheets/d/[INI_SHEET_ID]/edit
SHEET_ID=your_output_sheet_id_here

# ID Google Sheet "Membership List" — sumber data member yang di-sync ke Supabase
# (dipakai /api/sync-members dan step 9 pipeline). Wajib diisi, tanpa default.
# Ambil dari URL: https://docs.google.com/spreadsheets/d/[INI_SHEET_ID]/edit
MEMBERSHIP_SHEET_ID=your_membership_sheet_id_here

# ID Google Sheet "PPC Coaching Log" — input coaching harian admin
# (dipakai /api/debug-coaching dan sync coaching). Wajib diisi, tanpa default.
# Ambil dari URL: https://docs.google.com/spreadsheets/d/[INI_SHEET_ID]/edit
COACHING_SHEET_ID=your_coaching_sheet_id_here


# ── Supabase ──────────────────────────────────────────────────────────────
# Project URL — ambil dari: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co

# Service Role Key — ambil dari: Settings → API → service_role (bukan anon!)
# JANGAN commit nilai asli ke git — isi di Vercel Environment Variables saja
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
